---
import ThemeToggle from "@/components/ThemeToggle.astro"
import { siteConfig } from "@/config/site"
import { settings } from "@/config/settings"
import { navLinks } from "@/lib/links"

const currentPath = Astro.url.pathname
---

<header class="select-none">
  <nav
    aria-label="Main"
    class="mx-auto justify-between px-4 md:flex md:items-center md:px-8 lg:max-w-7xl"
  >
    <div>
      <div class="flex items-center justify-between py-3 md:block md:py-5">
        <a href="/">
          <span class="block text-2xl font-bold duration-200 lg:hover:scale-[1.10]">
            {siteConfig.name}
          </span>
        </a>
        <div class="flex gap-1 md:hidden">
          <button
            type="button"
            id="nav-toggle"
            class="group rounded-md p-2 text-primary outline-hidden focus:border focus:border-primary"
            aria-label="Menu"
            aria-controls="nav-menu"
            aria-expanded="false"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="hidden h-6 w-6 group-aria-expanded:block"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                clip-rule="evenodd"
              ></path>
            </svg>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6 group-aria-expanded:hidden"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 6h16M4 12h16M4 18h16"
              ></path>
            </svg>
          </button>
          {settings.themeToggleEnabled && (
            <ThemeToggle id="theme-menu-mobile" />
          )}
        </div>
      </div>
    </div>
    <div>
      <div
        id="nav-menu"
        class="absolute right-0 left-0 z-10 m-auto hidden w-full max-w-[20rem] justify-self-center rounded-md border bg-background p-4 md:static md:mt-0 md:block md:border-none md:p-0"
      >
        <ul class="flex flex-col items-center space-y-4 text-primary opacity-60 md:flex-row md:space-y-0 md:space-x-6">
          {navLinks.map((link) => (
            <li>
              <a
                class="hover:underline"
                href={link.path}
                aria-current={link.path === currentPath ? "page" : undefined}
              >
                {link.route}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    {settings.themeToggleEnabled && (
      <div class="hidden md:block">
        <ThemeToggle id="theme-menu-desktop" />
      </div>
    )}
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle")
  const menu = document.getElementById("nav-menu")

  if (toggle && menu) {
    const isOpen = () => toggle.getAttribute("aria-expanded") === "true"
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open))
      menu.classList.toggle("hidden", !open)
      document.body.classList.toggle("overflow-hidden", open)
    }

    toggle.addEventListener("click", () => setOpen(!isOpen()))
    menu.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        setOpen(false)
      }
    })
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        setOpen(false)
        toggle.focus()
      }
    })
    // The menu is always visible from the md breakpoint up.
    matchMedia("(width >= 48rem)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false)
    })
  }
</script>
