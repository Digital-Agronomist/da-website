---
import { Image } from "astro:assets"
import { heroHeader } from "@/config/contents"
import { siteConfig } from "@/config/site"
import { buttonClasses } from "@/lib/button"
---

<section class="container flex flex-col gap-4 pt-4 pb-12 text-center lg:items-center lg:gap-8 lg:py-20">
  <div class="flex flex-1 flex-col items-center gap-4 text-center lg:gap-8">
    <div class="space-y-4">
      <h1 class="text-4xl font-bold lg:text-6xl">{heroHeader.header}</h1>
      <p class="text-lg font-light text-muted-foreground lg:text-3xl">
        {heroHeader.subheader}
      </p>
    </div>
    <a
      href={siteConfig.publisher.url}
      target="_blank"
      rel="noopener noreferrer"
      class={`w-[10rem] ${buttonClasses({ size: "lg" })}`}
    >
      Learn More
      <span class="sr-only">
        {` about ${siteConfig.publisher.name} (opens in a new tab)`}
      </span>
    </a>
  </div>
  {/* App screenshot: Astro crops it to its top 5:3 at build time. The
    gradient fades the cut edge into the screenshot's own background
    (#f8f8f6), which reads well in both themes. */}
  {heroHeader.image && (
    <div class="relative mt-4 w-full max-w-4xl self-center overflow-hidden rounded-xl border shadow-2xl">
      <Image
        src={heroHeader.image}
        alt={heroHeader.imageAlt ?? ""}
        width={1792}
        height={1075}
        fit="cover"
        position="top"
        widths={[640, 960, 1280, 1792]}
        sizes="(width >= 60rem) 56rem, calc(100vw - 4rem)"
        priority
        class="h-auto w-full"
      />
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 bottom-0 h-1/4 bg-linear-to-t from-[#f8f8f6]"
      ></div>
    </div>
  )}
</section>
