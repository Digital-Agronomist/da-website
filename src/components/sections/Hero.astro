---
import { Image } from "astro:assets"
import { heroHeader } from "@/config/contents"
import { siteConfig } from "@/config/site"
import { buttonClasses } from "@/lib/button"
---

<section class="container flex flex-col gap-4 pt-4 pb-12 text-center lg:items-center lg:gap-8 lg:py-20">
  <div class="flex flex-1 flex-col items-center gap-4 text-center lg:gap-8">
    <div class="space-y-4">
      <h1 class="text-4xl font-bold lg:text-6xl">{heroHeader.header}</h1>
      <p class="text-lg font-light text-muted-foreground lg:text-3xl">
        {heroHeader.subheader}
      </p>
    </div>
    <a
      href={siteConfig.publisher.url}
      target="_blank"
      rel="noopener noreferrer"
      class={`w-[10rem] ${buttonClasses({ size: "lg" })}`}
    >
      Learn More
      <span class="sr-only">
        {` about ${siteConfig.publisher.name} (opens in a new tab)`}
      </span>
    </a>
  </div>
  {heroHeader.image && (
    <div class="flex flex-1 justify-center lg:justify-end">
      <Image
        src={heroHeader.image}
        alt={heroHeader.imageAlt ?? ""}
        width={500}
        densities={[1, 2]}
        priority
      />
    </div>
  )}
</section>
